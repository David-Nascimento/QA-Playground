# Arquivos que não devem ser enviados para Vercel
# (mas os arquivos compilados precisam estar incluídos)

# Código fonte: NÃO ignorar src/, public/, server/ e tools/
# (o build da Vercel usa todos eles)

# Arquivos de desenvolvimento
node_modules/
package-lock.json

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Scripts de migração (não necessários no deploy)
# A barra inicial limita à raiz: sem ela, "scripts/" ignoraria qualquer pasta
# com esse nome no projeto.
/scripts/

# Documentação de desenvolvimento (só a pasta da raiz).
# Atenção: "docs/" sem barra inicial também ignorava server/docs/, que é
# código da API (documentação servida em GET /api e coleção Postman).
/docs/
